plugins { id 'nf-fairscape' }

fairscape {
    file = 'results/ro-crate-metadata.json'
    overwrite = true

    // Core crate fields have dedicated options in the `fairscape` scope:
    author      = 'Ada Lovelace'
    description = 'A minimal demonstration pipeline that builds a three-item list and reverses it with GNU tac, packaged as a FAIRSCAPE EVI RO-Crate.'
    keywords    = ['example', 'reverse-list', 'coreutils']   // -> root crate keywords (and dataset keywords)
    license     = 'https://spdx.org/licenses/CC-BY-4.0'
    organization = 'Analytical Engine Institute'             // -> root `publisher`

    // Everything else is merged onto the root RO-Crate entity via `metadata`.
    // Any field the FAIRSCAPE profile root recognizes — or any custom key — is kept.
    // (name/description/author also work here if you prefer one block; the dedicated
    //  options above are just shortcuts for the most common ones.)
    metadata = [
        name                 : 'reverse-list demonstration crate',   // overrides the workflow/manifest name on the root
        principalInvestigator: 'Ada Lovelace',
        funder               : 'Example Research Program (grant #0000000)',
        associatedPublication: 'https://doi.org/10.1000/example-reverse-list',
        citation             : 'Lovelace A. reverse-list: an nf-fairscape demonstration. 2026.',
        contactEmail         : 'ada@example.org',
        conditionsOfAccess   : 'Example crate for demonstration purposes; no access restrictions.',
        copyrightNotice      : 'Copyright (c) 2026 Analytical Engine Institute.'
    ]
}
